{
  "info": {
    "_postman_id": "iris-sales-module-collection",
    "name": "IRIS CRM — Sales Module",
    "description": "Identity/RBAC + Sales module (Leads, Opportunities, Quotations, Catalog) API for the IRIS backend. Run \"Identity\" folder first (top to bottom) to bootstrap tokens/ids used by later requests, then run \"Sales Flow\" top to bottom for the full lead -> opportunity -> quotation -> win happy path. Import the companion IRIS-Local environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Identity",
      "item": [
        {
          "name": "Login — Super Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{superAdminEmail}}\",\n  \"password\": \"{{superAdminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(function () {",
                  "const data = pm.response.json().data;",
                  "pm.environment.set(\"accessToken\", data.accessToken);",
                  "pm.environment.set(\"refreshToken\", data.refreshToken);",
                  "pm.environment.set(\"regionId\", data.user.regionId);",
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "})();"
                ]
              }
            }
          ]
        },
