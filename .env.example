NODE_ENV=development
PORT=3000

# Local PostgreSQL (self-managed, per Infrastructure_Dev_Setup_Guide)
DATABASE_URL=postgresql://gourav@127.0.0.1:5432/irisCRM

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Cloudflare R2 (S3-compatible) - not wired up yet, placeholders for the storage module
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# HRMS — encrypts bank/PAN/Aadhaar/UAN fields at rest. REQUIRED in production
# (generate once with: openssl rand -base64 48) and never change it afterwards,
# or existing encrypted values become unreadable.
HR_ENCRYPTION_KEY=
# Timezone that defines an attendance "work date"
HR_TIMEZONE=Asia/Kolkata
